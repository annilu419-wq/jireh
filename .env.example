# ─────────────────────────────────────────────────────────────────────────────
#  Jireh · variables de entorno (PLANTILLA)
#  Copia este archivo como  .env.local  y rellena los valores reales.
#  .env.local NUNCA se sube al repositorio (ya está en .gitignore).
#  NINGÚN secreto lleva prefijo NEXT_PUBLIC_ (eso lo haría visible en el navegador).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Dónde: panel de Supabase → tu proyecto → Project Settings → API
#   · Project URL            → NEXT_PUBLIC_SUPABASE_URL  y  SUPABASE_URL (la misma)
#   · Publishable key (sb_publishable_...) → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   · Secret key      (sb_secret_...)      → SUPABASE_SECRET_KEY  (¡solo servidor!)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# ── Más adelante (Sesión 6) ────────────────────────────────────────────────
# RESEND_API_KEY=            # correos (acceso post-compra, etc.) — solo servidor
# EMAIL_FROM=hola@tudominio.com

# ── Hotmart (cobros) ───────────────────────────────────────────────────────
# HOTTOK: Hotmart → Herramientas → Webhook → "Hottok". Solo servidor. NUNCA por chat.
HOTMART_HOTTOK=…
# ID del producto Jireh en Hotmart (los avisos de otros productos se ignoran)
HOTMART_PRODUCT_ID=8947528
# Candado de membresía: "true" en Vercel el día del lanzamiento. Apagado = la app abre para cualquier sesión.
PAYWALL_ACTIVO=false
